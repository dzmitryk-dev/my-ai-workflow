#!/usr/bin/env bash
# bin/setup — install/remove skills and agents, plus the pinned Superpowers
# plugin for Codex and opencode.
#
# Usage:
#   ./bin/setup                       # install for every detected CLI
#   ./bin/setup --cli=opencode        # install for one CLI only (comma-separated)
#   ./bin/setup --link                # use symlinks instead of copies
#   ./bin/setup --dry-run             # print what would happen, change nothing
#   ./bin/setup --uninstall           # remove previously installed links/copies
#   ./bin/setup --uninstall --dry-run # preview uninstall
#
# Behavior:
#   - Copies/symlinks each selected CLI's skill and agent variants to its
#     expected global directories.
#   - Uses native Codex/OpenCode plugin commands for the pinned Superpowers
#     plugin; tracks owned plugin entries separately in .setup-state.
#   - For opencode, installs the guardrail plugins from integrations/opencode/
#     and merges the managed `permissions`/`policies` keys into the global
#     opencode.jsonc. The file is backed up before every merge.
#   - Re-running is safe; --uninstall removes only entries recorded by setup.

set -euo pipefail

# ---- args ---------------------------------------------------------------
MODE="install"            # install | uninstall
LINK_MODE="copy"          # copy | symlink
DRY_RUN=0
CLI_FILTER=""             # empty = auto-detect all installed CLIs
DEST_OVERRIDE=""          # optional, e.g. --dest=opencode=~/custom/path

for arg in "$@"; do
  case "$arg" in
    --install)            MODE="install" ;;
    --uninstall)          MODE="uninstall" ;;
    --link)               LINK_MODE="symlink" ;;
    --copy)               LINK_MODE="copy" ;;
    --dry-run|-n)         DRY_RUN=1 ;;
    --cli=*)              CLI_FILTER="${arg#--cli=}" ;;
    --dest=*)             DEST_OVERRIDE="${arg#--dest=}" ;;
    -h|--help)
      sed -n '2,18p' "$0"
      exit 0
      ;;
    *)
      echo "Unknown argument: $arg" >&2
      exit 2
      ;;
  esac
done

# ---- paths --------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
SKILLS_DIR="$REPO_ROOT/skills"
AGENTS_DIR="$REPO_ROOT/agents"
STATE_DIR="$REPO_ROOT/.setup-state"
STATE_FILE="$STATE_DIR/installed.tsv"
SUPERPOWERS_STATE_FILE="$STATE_DIR/superpowers.tsv"
SUPERPOWERS_MANIFEST="$REPO_ROOT/integrations/superpowers.env"
OPENCODE_GUARDRAILS_DIR="$REPO_ROOT/integrations/opencode"

if [[ $DRY_RUN -eq 0 ]]; then
  mkdir -p "$STATE_DIR"
  [[ -f "$STATE_FILE" ]] || : > "$STATE_FILE"
fi

# ---- logging ------------------------------------------------------------
say()  { printf '%s\n' "$*"; }
warn() { printf 'warn: %s\n' "$*" >&2; }
err()  { printf 'error: %s\n' "$*" >&2; exit 1; }

run() {
  # Run a command unless --dry-run.
  if [[ $DRY_RUN -eq 1 ]]; then
    printf '  (dry-run) %s\n' "$*"
  else
    "$@"
  fi
}

# ---- destination resolver ----------------------------------------------
# Output two lines:
#   <skills_root>
#   <agents_root>
# Or exit non-zero if the CLI is not installed / not requested.
resolve_dest() {
  local cli="$1"

  # Allow caller to skip with --cli filter.
  if [[ -n "$CLI_FILTER" ]]; then
    local IFS=','
    local wanted=0
    local f
    for f in $CLI_FILTER; do
      if [[ "$f" == "$cli" ]]; then wanted=1; break; fi
    done
    [[ $wanted -eq 1 ]] || return 1
  fi

  local skills_root="" agents_root=""
  case "$cli" in
    claude-code)
      local base="${CLAUDE_HOME:-$HOME/.claude}"
      skills_root="$base/skills"
      agents_root="$base/agents"
      [[ -d "$base" ]] || return 1
      ;;
    codex)
      local base="${CODEX_HOME:-$HOME/.codex}"
      skills_root="$base/skills"
      agents_root="$base/agents"
      [[ -d "$base" || -d "${CODEX_HOME:-$HOME/.agents}" ]] || return 1
      # Codex also reads ~/.agents/skills; we install into both when $CLIC is global.
      ;;
    opencode)
      local base="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
      skills_root="$base/skills"
      agents_root="$base/agents"
      [[ -d "$base" ]] || return 1
      ;;
    *)
      warn "unknown CLI: $cli"
      return 1
      ;;
  esac

  # Per-CLI dest override.
  if [[ -n "$DEST_OVERRIDE" ]]; then
    local pair
    pair=$(printf '%s' "$DEST_OVERRIDE" | awk -F= -v c="$cli" '
      { for (i=1; i<=NF; i++) if ($i ~ "^"c"=") { sub("^"c"=", "", $i); print $i; exit } }
    ')
    if [[ -n "$pair" ]]; then
      skills_root="$pair/skills"
      agents_root="$pair/agents"
    fi
  fi

  printf '%s\n%s\n' "$skills_root" "$agents_root"
}

# Detect which CLIs to target.
detect_clis() {
  local clis=()
  for cli in claude-code codex opencode; do
    if resolve_dest "$cli" >/dev/null 2>&1; then
      clis+=("$cli")
    fi
  done
  printf '%s\n' "${clis[@]}"
}

# ---- filesystem helpers -------------------------------------------------
is_inside_repo() {
  local path="$1"
  case "$path" in
    "$REPO_ROOT"/*) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_dir() {
  if [[ $DRY_RUN -eq 1 ]]; then
    printf '  (dry-run) mkdir -p %q\n' "$1"
  else
    mkdir -p "$1"
  fi
}

# Place a file at $dest_path, either by copying $src_path or symlinking it.
# Existing dest is removed unless it already points into this repo.
install_file() {
  local src_path="$1" dest_path="$2" cli="$3" entry="$4"

  ensure_dir "$(dirname "$dest_path")"

  if [[ -L "$dest_path" || -e "$dest_path" ]]; then
    local current
    current="$(readlink -f -- "$dest_path" 2>/dev/null || true)"
    if [[ "$current" == "$(readlink -f -- "$src_path")" ]]; then
      say "  ok  $cli: $entry"
      return 0
    fi
    if is_inside_repo "$current"; then
      # Points somewhere else in this repo — leave it.
      warn "$cli: $entry already installed from a different path: $current"
      return 0
    fi
    warn "$cli: replacing existing $dest_path"
    run rm -rf -- "$dest_path"
  fi

  if [[ $LINK_MODE == symlink ]]; then
    run ln -s -- "$src_path" "$dest_path"
  else
    run cp -- "$src_path" "$dest_path"
  fi

  if [[ $DRY_RUN -eq 0 ]]; then
    local state_entry
    state_entry="$(printf '%s\t%s' "$cli" "$dest_path")"
    # Re-runs must not grow the state file with the same path over and over.
    if ! grep -qxF -- "$state_entry" "$STATE_FILE" 2>/dev/null; then
      printf '%s\n' "$state_entry" >> "$STATE_FILE"
    fi
  fi
  say "  +  $cli: $entry"
}

# Recursively install a directory: copies/symlinks every file under $src_dir
# into the matching path under $dest_dir, preserving relative layout.
install_tree() {
  local src_dir="$1" dest_dir="$2" cli="$3" entry="$4"

  [[ -d "$src_dir" ]] || { warn "skip $entry ($cli): missing $src_dir"; return 0; }

  if [[ $LINK_MODE == symlink ]]; then
    # For symlinks, the cleanest approach is a symlink at the parent: any
    # file the CLI opens will follow the link back to this repo.
    ensure_dir "$(dirname "$dest_dir")"
    if [[ -L "$dest_dir" || -e "$dest_dir" ]]; then
      local current
      current="$(readlink -f -- "$dest_dir" 2>/dev/null || true)"
      if [[ "$current" == "$src_dir" ]]; then
        say "  ok  $cli: $entry"
        return 0
      fi
      if is_inside_repo "$current"; then
        warn "$cli: $entry already installed from $current"
        return 0
      fi
      warn "$cli: replacing existing $dest_dir"
      run rm -rf -- "$dest_dir"
    fi
    run ln -s -- "$src_dir" "$dest_dir"
    if [[ $DRY_RUN -eq 0 ]]; then
      printf '%s\t%s\n' "$cli" "$dest_dir" >> "$STATE_FILE"
    fi
    say "  +  $cli: $entry (symlinked)"
  else
    # install_file ensures $dest_dir (via dirname on its first file) and any
    # nested subdirectories. mkdir -p is idempotent, so there's no harm in
    # letting each file install its own parent dir.
    local f rel
    while IFS= read -r -d '' f; do
      rel="${f#"$src_dir"/}"
      install_file "$f" "$dest_dir/$rel" "$cli" "$entry/$rel"
    done < <(find "$src_dir" -type f -print0)
  fi
}

# ---- global Superpowers plugins ----------------------------------------
cli_selected() {
  local wanted="$1"
  [[ -z "$CLI_FILTER" ]] && return 0
  local IFS=',' cli
  for cli in $CLI_FILTER; do
    [[ "$cli" == "$wanted" ]] && return 0
  done
  return 1
}

plugin_run() {
  # Run a native CLI command without eval; in dry-run only display it.
  if [[ $DRY_RUN -eq 1 ]]; then
    printf '  (dry-run)'
    printf ' %q' "$@"
    printf '\n'
  else
    "$@"
  fi
}

plugin_state_has() {
  local record="$1"
  [[ -f "$SUPERPOWERS_STATE_FILE" ]] && grep -Fqx -- "$record" "$SUPERPOWERS_STATE_FILE"
}

plugin_state_add() {
  local record="$1"
  [[ $DRY_RUN -eq 1 ]] && return 0
  mkdir -p "$STATE_DIR"
  : >> "$SUPERPOWERS_STATE_FILE"
  plugin_state_has "$record" || printf '%s\n' "$record" >> "$SUPERPOWERS_STATE_FILE"
}

codex_marketplace_identity() {
  # Print one of: absent, matching, conflict, unknown. The list command does
  # not expose the Git ref on every Codex version, so the native add --json
  # result is authoritative for whether the configured source is already
  # installed at the requested ref.
  local output
  if ! output="$(codex plugin marketplace list --json 2>/dev/null)"; then
    return 2
  fi
  printf '%s' "$output" | python3 -c '
import json, os, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print("unknown")
    raise SystemExit
name = os.environ["SUPERPOWERS_CODEX_MARKETPLACE"]
want_url = os.environ["SUPERPOWERS_REPOSITORY"]
if want_url.endswith(".git"):
    want_url = want_url[:-4]
want_url = want_url.rstrip("/")
want_ref = os.environ["SUPERPOWERS_REF"]
items = data.get("marketplaces", []) if isinstance(data, dict) else []
for item in items:
    if not isinstance(item, dict) or item.get("name") != name:
        continue
    source = item.get("marketplaceSource") or item.get("source")
    url = ref = None
    if isinstance(source, dict):
        url = source.get("url") or source.get("source") or source.get("repository")
        ref = source.get("ref") or item.get("ref")
    elif isinstance(source, str):
        url = source
        ref = item.get("ref")
    if not url:
        print("unknown")
        break
    if "#" in url:
        url, inline_ref = url.rsplit("#", 1)
        ref = ref or inline_ref
    if url.endswith(".git"):
        url = url[:-4]
    url = url.rstrip("/")
    print("matching" if url == want_url and (ref is None or ref == want_ref) else "conflict")
    break
else:
    print("absent")
'
}

codex_marketplace_add_result() {
  printf '%s' "$1" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    name = data["marketplaceName"]
    already_added = data["alreadyAdded"]
    if not isinstance(name, str) or not isinstance(already_added, bool):
        raise ValueError("invalid marketplace add response")
except Exception:
    raise SystemExit(1)
print(name + "\t" + ("true" if already_added else "false"))
'
}

codex_marketplace_present() {
  local marketplace_name="$1" output
  if ! output="$(codex plugin marketplace list --json 2>/dev/null)"; then
    return 2
  fi
  printf '%s' "$output" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    raise SystemExit(2)
name = sys.argv[1]
for item in data.get("marketplaces", []) if isinstance(data, dict) else []:
    if isinstance(item, dict) and item.get("name") == name:
        raise SystemExit(0)
raise SystemExit(1)
' "$marketplace_name"
}

codex_plugin_id_present() {
  local plugin_name="$1" marketplace_name="$2"
  local output
  if ! output="$(codex plugin list --json 2>/dev/null)"; then
    return 2
  fi
  printf '%s' "$output" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    raise SystemExit(2)
name, marketplace = sys.argv[1:]
for item in data.get("installed", []) if isinstance(data, dict) else []:
    if not isinstance(item, dict):
        continue
    plugin = item.get("name") or item.get("plugin") or item.get("id")
    market = item.get("marketplace") or item.get("marketplaceName")
    if (plugin == name and market == marketplace) or plugin == name + "@" + marketplace:
        raise SystemExit(0)
raise SystemExit(1)
' "$plugin_name" "$marketplace_name"
}

codex_plugin_present() {
  codex_plugin_id_present "$SUPERPOWERS_CODEX_PLUGIN" "$SUPERPOWERS_CODEX_MARKETPLACE"
}

opencode_plugin_spec_present() {
  local spec="$1" package_name="$2"
  local output
  if ! output="$(opencode plugin list 2>/dev/null)"; then
    return 2
  fi
  # The list is human-readable rather than structured. Match either the
  # configured package spec or its package name as a distinct token.
  grep -Fq -- "$spec" <<< "$output" || \
    grep -Eq -- "(^|[[:space:]])${package_name}([[:space:]]|$)" <<< "$output"
}

opencode_plugin_present() {
  opencode_plugin_spec_present "$SUPERPOWERS_OPENCODE_SPEC" "$SUPERPOWERS_CODEX_PLUGIN"
}

do_superpowers_install() {
  [[ -f "$SUPERPOWERS_MANIFEST" ]] || { warn "skip Superpowers plugins: missing $SUPERPOWERS_MANIFEST"; return 0; }
  # This manifest is maintained in-repository and contains only public source
  # coordinates; do not load any machine-specific configuration here.
  # shellcheck disable=SC1090
  source "$SUPERPOWERS_MANIFEST"
  : "${SUPERPOWERS_REPOSITORY:?missing repository in $SUPERPOWERS_MANIFEST}"
  : "${SUPERPOWERS_REF:?missing ref in $SUPERPOWERS_MANIFEST}"
  : "${SUPERPOWERS_CODEX_MARKETPLACE:?missing marketplace in $SUPERPOWERS_MANIFEST}"
  : "${SUPERPOWERS_CODEX_PLUGIN:?missing plugin in $SUPERPOWERS_MANIFEST}"
  SUPERPOWERS_OPENCODE_SPEC="git+${SUPERPOWERS_REPOSITORY}#${SUPERPOWERS_REF}"
  export SUPERPOWERS_REPOSITORY SUPERPOWERS_REF SUPERPOWERS_CODEX_MARKETPLACE SUPERPOWERS_CODEX_PLUGIN

  if cli_selected codex && command -v codex >/dev/null 2>&1; then
    say "[codex] Superpowers plugin"
    local market_status marketplace_output marketplace_result marketplace_name already_added
    if ! market_status="$(codex_marketplace_identity)"; then
      warn "codex: cannot inspect marketplaces; skipping Superpowers install"
      market_status="failed"
    elif [[ "$market_status" == conflict ]]; then
      warn "codex: marketplace '$SUPERPOWERS_CODEX_MARKETPLACE' conflicts with the pinned Superpowers source; leaving it untouched"
      market_status="failed"
    elif [[ $DRY_RUN -eq 1 ]]; then
      plugin_run codex plugin marketplace add "$SUPERPOWERS_REPOSITORY" --ref "$SUPERPOWERS_REF" --json
      market_status="ready"
    elif marketplace_output="$(codex plugin marketplace add "$SUPERPOWERS_REPOSITORY" --ref "$SUPERPOWERS_REF" --json 2>&1)"; then
      if ! marketplace_result="$(codex_marketplace_add_result "$marketplace_output")"; then
        warn "codex: could not parse marketplace add result; leaving marketplace ownership untracked"
        market_status="failed"
      else
        IFS=$'\t' read -r marketplace_name already_added <<< "$marketplace_result"
        if [[ "$marketplace_name" != "$SUPERPOWERS_CODEX_MARKETPLACE" ]]; then
          if [[ "$already_added" == false ]]; then
            if ! plugin_run codex plugin marketplace remove "$marketplace_name"; then
              warn "codex: failed to remove unexpected marketplace '$marketplace_name'; it may need manual cleanup"
            fi
          fi
          warn "codex: pinned source resolved to marketplace '$marketplace_name', expected '$SUPERPOWERS_CODEX_MARKETPLACE'; skipping plugin install"
          market_status="failed"
        else
          market_status="ready"
          if [[ "$already_added" == false ]]; then
            plugin_state_add $'codex-marketplace\t'"$SUPERPOWERS_CODEX_MARKETPLACE"
          fi
        fi
      fi
    else
      warn "codex: failed to register the pinned Superpowers marketplace; skipping plugin install"
      market_status="failed"
    fi

    if [[ "$market_status" == ready ]]; then
      local plugin_status
      if codex_plugin_present; then
        :
      else
        plugin_status=$?
        if [[ $plugin_status -eq 2 ]]; then
          warn "codex: cannot inspect installed plugins; skipping Superpowers plugin install"
        else
          if plugin_run codex plugin add "${SUPERPOWERS_CODEX_PLUGIN}@${SUPERPOWERS_CODEX_MARKETPLACE}"; then
            plugin_state_add $'codex-plugin\t'"$SUPERPOWERS_CODEX_PLUGIN"$'\t'"$SUPERPOWERS_CODEX_MARKETPLACE"
          else
            warn "codex: failed to install Superpowers plugin; ownership was not recorded"
          fi
        fi
      fi
    fi
  fi

  if cli_selected opencode && command -v opencode >/dev/null 2>&1; then
    say "[opencode] Superpowers plugin"
    local open_status
    if opencode_plugin_present; then
      :
    else
      open_status=$?
      if [[ $open_status -eq 2 ]]; then
        warn "opencode: cannot inspect installed plugins; skipping Superpowers install"
      else
        if plugin_run opencode plugin add "$SUPERPOWERS_OPENCODE_SPEC"; then
          plugin_state_add $'opencode-plugin\t'"$SUPERPOWERS_OPENCODE_SPEC"$'\t'"$SUPERPOWERS_CODEX_PLUGIN"
        else
          warn "opencode: failed to install Superpowers plugin; ownership was not recorded"
        fi
      fi
    fi
  fi
}

do_superpowers_uninstall() {
  [[ -s "$SUPERPOWERS_STATE_FILE" ]] || return 0
  local temp="$SUPERPOWERS_STATE_FILE.tmp.$$"
  : > "$temp"
  local kind a b keep pass installed_output status
  # Remove owned plugins before marketplaces so we can safely preserve a
  # marketplace that another installed plugin still references.
  for pass in plugins marketplaces other; do
    while IFS=$'\t' read -r kind a b; do
      [[ -n "$kind" ]] || continue
      keep=0
      case "$kind" in
        codex-plugin)
          [[ "$pass" == plugins ]] || continue
          if ! cli_selected codex; then keep=1
          elif command -v codex >/dev/null 2>&1; then
            if codex_plugin_id_present "$a" "$b"; then
              if plugin_run codex plugin remove "$a@$b"; then
                say "  -  codex plugin $a@$b"
              else
                warn "codex: failed to remove plugin $a@$b; ownership retained for retry"
                keep=1
              fi
            else
              status=$?
              if [[ $status -eq 2 ]]; then
                warn "skip owned Codex plugin $a@$b: cannot inspect installed plugins"
                keep=1
              fi
            fi
          else
            warn "skip owned Codex plugin $a@$b: codex CLI is unavailable"
            keep=1
          fi
          ;;
        opencode-plugin)
          [[ "$pass" == plugins ]] || continue
          if ! cli_selected opencode; then keep=1
          elif command -v opencode >/dev/null 2>&1; then
            if opencode_plugin_spec_present "$a" "$b"; then
              if plugin_run opencode plugin remove "$a"; then
                say "  -  opencode plugin $a"
              else
                warn "opencode: failed to remove plugin $a; ownership retained for retry"
                keep=1
              fi
            else
              status=$?
              if [[ $status -eq 2 ]]; then
                warn "skip owned OpenCode plugin $a: cannot inspect installed plugins"
                keep=1
              fi
            fi
          else
            warn "skip owned OpenCode plugin $a: opencode CLI is unavailable"
            keep=1
          fi
          ;;
        codex-marketplace)
          [[ "$pass" == marketplaces ]] || continue
          if ! cli_selected codex; then keep=1
          elif ! command -v codex >/dev/null 2>&1; then
            warn "skip owned Codex marketplace $a: codex CLI is unavailable"
            keep=1
          else
            if codex_marketplace_present "$a"; then
              if ! installed_output="$(codex plugin list --json 2>/dev/null)"; then
                warn "skip owned Codex marketplace $a: cannot inspect installed plugins"
                keep=1
              elif printf '%s' "$installed_output" | python3 -c '
import json, sys
try: data = json.load(sys.stdin)
except Exception: raise SystemExit(2)
market, state_path, dry_run = sys.argv[1:]
owned = set()
if dry_run == "1":
    try:
        with open(state_path, encoding="utf-8") as state:
            for line in state:
                fields = line.rstrip("\n").split("\t")
                if len(fields) >= 3 and fields[0] == "codex-plugin":
                    owned.add(fields[1] + "@" + fields[2])
    except FileNotFoundError:
        pass
for item in data.get("installed", []):
    if not isinstance(item, dict):
        continue
    item_market = item.get("marketplace") or item.get("marketplaceName")
    item_id = item.get("pluginId") or item.get("id")
    if item_market == market and not (dry_run == "1" and item_id in owned):
        raise SystemExit(0)
raise SystemExit(1)
' "$a" "$SUPERPOWERS_STATE_FILE" "$DRY_RUN"; then
                warn "skip Codex marketplace $a: another installed plugin still uses it"
                keep=1
              else
                status=$?
                if [[ $status -eq 1 ]]; then
                  if plugin_run codex plugin marketplace remove "$a"; then
                    say "  -  codex marketplace $a"
                  else
                    warn "codex: failed to remove marketplace $a; ownership retained for retry"
                    keep=1
                  fi
                else
                  warn "skip owned Codex marketplace $a: cannot parse installed plugins"
                  keep=1
                fi
              fi
            else
              status=$?
              if [[ $status -eq 2 ]]; then
                warn "skip owned Codex marketplace $a: cannot inspect marketplaces"
                keep=1
              fi
            fi
          fi
          ;;
        *)
          [[ "$pass" == other ]] || continue
          warn "skip unknown Superpowers state record: $kind"
          keep=1
          ;;
      esac
      if [[ $keep -eq 1 ]]; then
        printf '%s\t%s\t%s\n' "$kind" "$a" "$b" >> "$temp"
      fi
    done < "$SUPERPOWERS_STATE_FILE"
  done

  if [[ $DRY_RUN -eq 1 ]]; then
    rm -f -- "$temp"
    say "Dry-run complete. Superpowers ownership state preserved."
  else
    mv "$temp" "$SUPERPOWERS_STATE_FILE"
    say "Superpowers plugin uninstall complete."
  fi
}

# ---- installer ----------------------------------------------------------
# ---- opencode guardrails -------------------------------------------------
# ~/.config/opencode/opencode.jsonc is a single global document — there is no
# include mechanism — so setup merges its managed keys into the existing file
# rather than replacing it. `permissions` and `policies` are owned by this repo;
# every other key (mcp, plugins, model, ...) is preserved. The file is backed up
# before each merge so a bad parse never costs the user their config.
opencode_config_apply() {
  local file="$1" fragment="$2" mode="$3"
  local verb="merged"
  [[ "$mode" == "clear" ]] && verb="removed"

  if [[ $DRY_RUN -eq 1 ]]; then
    printf '  (dry-run) %s opencode guardrails in %q\n' "$verb" "$file"
    return 0
  fi
  if [[ ! -f "$file" ]]; then
    warn "opencode: no config at $file; guardrails not applied"
    return 0
  fi

  # Date + PID: two setup runs in the same second must not overwrite each
  # other's only copy of the pre-merge config.
  local backup="$file.bak.$(date +%Y%m%d%H%M%S).$$"
  cp -- "$file" "$backup"

  if python3 - "$file" "$fragment" "$mode" <<'PY'
import json, os, sys, tempfile

path, fragment_path, mode = sys.argv[1:4]
MANAGED = ("permissions", "policies")


def strip_jsonc(text):
    """Drop // and /* */ comments and trailing commas, ignoring string bodies."""
    out, i, in_str, esc = [], 0, False, False
    while i < len(text):
        ch = text[i]
        if in_str:
            out.append(ch)
            if esc:
                esc = False
            elif ch == "\\":
                esc = True
            elif ch == '"':
                in_str = False
            i += 1
            continue
        if ch == '"':
            in_str = True
            out.append(ch)
            i += 1
            continue
        if text.startswith("//", i):
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        if text.startswith("/*", i):
            i += 2
            while i < len(text) and not text.startswith("*/", i):
                i += 1
            i += 2
            continue
        # Drop a trailing comma only outside strings: `",}"` in a value is data.
        if ch == ",":
            j = i + 1
            while j < len(text) and text[j] in " \t\r\n":
                j += 1
            if j < len(text) and text[j] in "}]":
                i += 1
                continue
        out.append(ch)
        i += 1
    return "".join(out)


def load(p):
    with open(p, encoding="utf-8") as fh:
        return json.loads(strip_jsonc(fh.read()))


doc = load(path)
if mode == "merge":
    frag = load(fragment_path)
    for key in MANAGED:
        value = frag.get(key) or []
        if value:
            doc[key] = value
        else:
            doc.pop(key, None)
else:
    for key in MANAGED:
        doc.pop(key, None)

fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".opencode-", suffix=".jsonc")
with os.fdopen(fd, "w", encoding="utf-8") as fh:
    fh.write(
        "// Managed by my-ai-workflow/bin/setup — `permissions` and `policies`\n"
        "// come from integrations/opencode/config.jsonc. Everything else here is\n"
        "// left alone. Edit the repo, not this file.\n"
    )
    json.dump(doc, fh, indent=2, ensure_ascii=False)
    fh.write("\n")
os.replace(tmp, path)
PY
  then
    say "  ok  opencode: guardrails $verb (backup: $(basename "$backup"))"
  else
    warn "opencode: failed to apply guardrails; previous file kept at $backup"
    warn "opencode: fix the JSON in $file, then re-run ./bin/setup --cli=opencode"
    return 1
  fi
}

do_opencode_guardrails_install() {
  local base="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
  [[ -d "$base" ]] || return 0

  say ""
  say "[opencode] guardrails -> $base"
  install_file "$OPENCODE_GUARDRAILS_DIR/plugins/git-approval.ts" \
    "$base/plugins/git-approval.ts" opencode "plugins/git-approval.ts"
  install_file "$OPENCODE_GUARDRAILS_DIR/plugins/fs-guard.ts" \
    "$base/plugins/fs-guard.ts" opencode "plugins/fs-guard.ts"
  opencode_config_apply "$base/opencode.jsonc" "$OPENCODE_GUARDRAILS_DIR/config.jsonc" merge
}

# These two filenames are owned by setup, so they are removed by name. The
# generic state-file loop cannot help here: it deliberately leaves copies alone
# (they are "yours to edit"), which would strand the plugins in place while
# their config rules disappeared — a half-uninstalled harness.
do_opencode_guardrails_uninstall() {
  local base="${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}"
  [[ -d "$base" ]] || return 0

  local plugin
  for plugin in git-approval.ts fs-guard.ts; do
    [[ -e "$base/plugins/$plugin" ]] || continue
    run rm -f -- "$base/plugins/$plugin"
    say "  -  opencode: plugins/$plugin"
  done
  opencode_config_apply "$base/opencode.jsonc" "$OPENCODE_GUARDRAILS_DIR/config.jsonc" clear
}

do_install() {
  local cli skills_root agents_root
  while IFS= read -r cli; do
    [[ -z "$cli" ]] && continue
    dests="$(resolve_dest "$cli")"
    skills_root="$(printf '%s\n' "$dests" | sed -n '1p')"
    agents_root="$(printf '%s\n' "$dests" | sed -n '2p')"

    say ""
    say "[$cli] skills -> $skills_root"
    say "[$cli] agents -> $agents_root"

    # Skills: each skills/<skill>/<cli>/ -> <skills_root>/<skill>/
    if [[ -d "$SKILLS_DIR" ]]; then
      local skill_dir cli_dir name
      while IFS= read -r -d '' skill_dir; do
        name="$(basename "$skill_dir")"
        cli_dir="$skill_dir/$cli"
        [[ -d "$cli_dir" ]] || continue
        install_tree "$cli_dir" "$skills_root/$name" "$cli" "skills/$name"
      done < <(find "$SKILLS_DIR" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
    fi

    # Agents: each agents/<agent>/<cli>/ -> <agents_root>/<agent>/
    if [[ -d "$AGENTS_DIR" ]]; then
      local agent_dir cli_dir name
      while IFS= read -r -d '' agent_dir; do
        name="$(basename "$agent_dir")"
        cli_dir="$agent_dir/$cli"
        [[ -d "$cli_dir" ]] || continue
        install_tree "$cli_dir" "$agents_root/$name" "$cli" "agents/$name"
      done < <(find "$AGENTS_DIR" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
    fi
  done < <(detect_clis)

  if cli_selected opencode && [[ -d "${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}" ]]; then
    do_opencode_guardrails_install
  fi

  do_superpowers_install

  if [[ $DRY_RUN -eq 1 ]]; then
    say ""
    say "Dry-run complete. No changes were made."
  else
    say ""
    say "Done. Installed paths are tracked in $STATE_FILE."
    say "Re-run with --uninstall to remove."
  fi
}

do_uninstall() {
  # Removed before the state loop: the loop skips copies by design, which would
  # leave these plugins loaded after their config rules were cleared.
  if cli_selected opencode && [[ -d "${OPENCODE_CONFIG_DIR:-$HOME/.config/opencode}" ]]; then
    do_opencode_guardrails_uninstall
  fi

  if [[ ! -s "$STATE_FILE" ]]; then
    say "Nothing to uninstall (no state file)."
  else
    say "Removing previously installed paths:"
    local cli path
    while IFS=$'\t' read -r cli path; do
      [[ -z "$path" ]] && continue
      if [[ -L "$path" ]]; then
        run rm -f -- "$path"
        say "  -  $path"
      elif [[ -e "$path" ]]; then
        # Only remove if it's still under our repo (defensive).
        local target
        target="$(readlink -f -- "$path" 2>/dev/null || true)"
        if is_inside_repo "$target"; then
          run rm -f -- "$path"
          say "  -  $path"
        else
          warn "skip $path: no longer points into $REPO_ROOT"
        fi
      fi
    done < "$STATE_FILE"

    if [[ $DRY_RUN -eq 0 ]]; then
      : > "$STATE_FILE"
      say "Uninstall complete."
    else
      say "Dry-run complete. State file preserved."
    fi
  fi

  do_superpowers_uninstall
}

# ---- main ---------------------------------------------------------------
case "$MODE" in
  install)   do_install   ;;
  uninstall) do_uninstall ;;
  *) err "unknown mode: $MODE" ;;
esac
