#!/usr/bin/env bash
# bin/check-secrets — scan staged changes for common secret patterns.
#
# Use as a pre-commit hook:
#   ln -s ../../bin/check-secrets .git/hooks/pre-commit
#
# Or run directly:
#   ./bin/check-secrets             # scan staged changes
#   ./bin/check-secrets --all       # scan all tracked files
#   ./bin/check-secrets --staged    # (default) scan staged changes only
#
# Exit code: 0 if nothing found, 1 if suspicious lines were found.
#
# This is a heuristic scanner. It is NOT a replacement for gitleaks or
# git-secrets. False positives are possible; review every hit.

set -euo pipefail

MODE="staged"
for arg in "$@"; do
  case "$arg" in
    --staged) MODE="staged" ;;
    --all)    MODE="all" ;;
    -h|--help)
        sed -n '2,16p' "$0"
        exit 0
        ;;
    *)
        echo "Unknown argument: $arg" >&2
        exit 2
        ;;
  esac
done

# Patterns. Each line is: <label>|<extended regex>
# Anchored so we don't match the literal words; we look for token-shaped strings.
PATTERNS=(
  "GitHub token|gh[pousr]_[A-Za-z0-9]{36,}"
  "OpenAI/Anthropic key|sk-(?!proj-)[A-Za-z0-9_-]{20,}"
  "OpenAI project key|sk-proj-[A-Za-z0-9_-]{20,}"
  "Slack token|xox[baprs]-[A-Za-z0-9-]{10,}"
  "Google API key|AIza[A-Za-z0-9_-]{35}"
  "AWS access key|AKIA[0-9A-Z]{16}"
  "Private key header|-----BEGIN (RSA |OPENSSH |EC |DSA |PGP |ENCRYPTED )?PRIVATE KEY-----"
  "Long base64-looking secret adjacent to a keyword|\\b(api[_-]?key|secret|token|password|passwd|pwd|access[_-]?key|auth[_-]?token)\\b['\"\"]?:?['\"\"]?\\s*['\"\"]?[A-Za-z0-9_/+-]{32,}"
)

# Files to scan based on mode.
if [[ $MODE == "staged" ]]; then
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "check-secrets: not inside a git repository" >&2
    exit 2
  fi
  mapfile -t FILES < <(git diff --cached --name-only --diff-filter=ACMR | grep -v '^bin/check-secrets$' || true)
  if [[ ${#FILES[@]} -eq 0 ]]; then
    echo "check-secrets: nothing staged, nothing to scan."
    exit 0
  fi
  echo "check-secrets: scanning ${#FILES[@]} staged file(s)…"
else
  mapfile -t FILES < <(git ls-files | grep -v '^bin/check-secrets$' || true)
  echo "check-secrets: scanning ${#FILES[@]} tracked file(s)…"
fi

# Skip binary files and large files; secret scanners should be fast.
is_text() {
  local f="$1"
  [[ -f "$f" ]] || return 1
  local size
  size=$(wc -c < "$f")
  [[ $size -lt 1048576 ]] || return 1   # >1 MiB
  file -b --mime "$f" | grep -q '^text/'
}

hits=0
for f in "${FILES[@]}"; do
  is_text "$f" || continue
  for entry in "${PATTERNS[@]}"; do
    label="${entry%%|*}"
    pat="${entry#*|}"
    # -P for Perl regex (faster, real alternation), -n for line numbers.
    # || true||\n to keep set -e quiet. || exit 1 used with || keyword for control.
    # We do not want any "found" line to abort the loop, so we || true.
    while IFS=: read -r file lineno match; do
      [[ -z "$file" ]] && continue
      printf '  %s:%s  [%s]  %s\n' "$file" "$lineno" "$label" "$match"
      hits=$((hits + 1))
    done < <(grep -nP "$pat" "$f" 2>/dev/null || true)
  done
done

if [[ $hits -gt 0 ]]; then
  echo ""
  echo "check-secrets: $hits suspicious line(s) found."
  echo "Review each hit. To bypass (only if you are sure): git commit --no-verify"
  exit 1
fi

echo "check-secrets: clean."
exit 0